                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    t.transaction_date,
    t.product_id,
    t.store_id,
    t.customer_id,
    t.quantity,
    t.quantity * p.product_retail_price AS revenue,
    t.quantity * p.product_cost         AS cost,
    (t.quantity * (p.product_retail_price - p.product_cost)) AS gross_profit
FROM silver.FMTransaction t
JOIN silver.Product p ON t.product_id = p.product_id;</property>
