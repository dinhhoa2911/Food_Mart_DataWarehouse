                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    transaction_id,
    TRY_CONVERT(DATE, transaction_date, 101) AS transaction_date, -- MM/DD/YYYY
    TRY_CONVERT(DATE, stock_date, 103) AS stock_date,              -- DD/MM/YYYY
    product_id,
    customer_id,
    store_id,
    quantity
FROM bronze.FMTransaction
WHERE
    TRY_CONVERT(DATE, transaction_date, 101) IS NOT NULL
    AND TRY_CONVERT(DATE, stock_date, 103) IS NOT NULL
    AND TRY_CAST(quantity AS INT) &gt; 0
    AND TRY_CONVERT(DATE, stock_date, 103) &lt;= TRY_CONVERT(DATE, transaction_date, 101);</property>
